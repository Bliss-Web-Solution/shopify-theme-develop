<div{% if block.settings.custom_class != blank %} class="{{ block.settings.custom_class }}"{% endif %}>
  {{ block.settings.custom_liquid }}
</div>

{% schema %}
{
  "name": "t:names.custom_liquid",
  "tag": null,
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "t:settings.custom_liquid",
      "info": "t:info.custom_liquid"
    },
    {
      "type": "header",
      "content": "Custom Class"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom Class",
      "placeholder": "my-custom-class"
    }
  ],
  "presets": [
    {
      "name": "t:names.custom_liquid",
      "category": "t:categories.custom"
    }
  ]
}
{% endschema %}
