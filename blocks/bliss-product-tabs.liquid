{% assign block_settings = block.settings %}

{%- if block_settings.background_color != blank or block_settings.text_color != blank -%}
  {% render 'contrast-override',
    background_color: block_settings.background_color,
    text_color: block_settings.text_color,
    section_id: block.id
  %}
{%- endif -%}

{% render 'accordion-styles' %}
<script src="{{ 'bliss-product-tabs.js' | asset_url }}" type="module" defer></script>

<product-tabs
  class="product-tabs-wrapper spacing-style{% if block_settings.background_color != blank or block_settings.text_color != blank %} color-custom-{{ block.id }}{% endif %}"
  style="
    {% render 'spacing-style', settings: block_settings %}
    {% if block_settings.border_color != blank %} --color-active-tab-underline: {{ block_settings.border_color }};{% endif %}
  "
  data-display-style="{{ block_settings.display_style | default: 'tabs' }}"
  {{ block.shopify_attributes }}
>
  {%- if block_settings.display_style == 'tabs' or block_settings.display_style == blank -%}
    <div class="product-tabs__nav" role="tablist">
      {%- comment -%} Dynamically generated by javascript on desktop {%- endcomment -%}
    </div>
  {%- endif -%}

  {%- comment -%} Icon class mirrors native accordion.liquid: accordion--caret or accordion--plus {%- endcomment -%}
  <div
    class="product-tabs__panels-container accordion accordion--dividers accordion--{{ block_settings.icon }}"
    data-faq-accordion="true"
  >
    {% content_for 'blocks' %}
  </div>
</product-tabs>

{% stylesheet %}
  .product-tabs-wrapper:not(:has(.product-tabs__accordion-item)) {
    display: none;
  }

  .product-tabs__nav {
    display: none;
    flex-wrap: wrap;
    gap: var(--gap-lg, 32px);
    border-block-end: 1px solid var(--color-border);
    padding-block-end: var(--padding-xs, 12px);
    margin-block-end: var(--margin-md, 24px);
  }

  .product-tabs__btn {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-body--family);
    font-size: 1.125rem;
    font-weight: 500;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text, 0.7));
    cursor: pointer;
    position: relative;
    transition: color 0.25s ease;
  }

  .product-tabs__btn::after {
    content: '';
    position: absolute;
    bottom: calc(-1.5px - var(--padding-xs, 12px));
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-active-tab-underline, rgb(var(--color-foreground-rgb)));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .product-tabs__btn.is-active {
    color: rgb(var(--color-foreground-rgb));
  }

  .product-tabs__btn.is-active::after {
    transform: scaleX(1);
  }

  .product-tabs__btn:hover {
    color: rgb(var(--color-foreground-rgb));
  }

  /* Desktop view styles for Tabs mode */
  @media screen and (min-width: 750px) {
    .product-tabs-wrapper[data-display-style="tabs"] .product-tabs__nav {
      display: flex;
    }

    /* Hide individual accordion summary headers on desktop when using tabs */
    .product-tabs-wrapper[data-display-style="tabs"] summary {
      display: none;
    }

    /* Hide inactive accordion elements on desktop when using tabs */
    .product-tabs-wrapper[data-display-style="tabs"] .product-tabs__accordion-item:not(.is-active) {
      display: none;
    }

    /* Show only active tab content on desktop when using tabs */
    .product-tabs-wrapper[data-display-style="tabs"] .product-tabs__accordion-item.is-active {
      display: block;
    }

    /* Override standard accordion border/padding styles on desktop when using tabs */
    .product-tabs-wrapper[data-display-style="tabs"] .accordion--dividers .product-tabs__accordion-item:not(:first-child) .details,
    .product-tabs-wrapper[data-display-style="tabs"] .accordion--dividers .product-tabs__accordion-item:first-child .details,
    .product-tabs-wrapper[data-display-style="tabs"] .accordion--dividers .product-tabs__accordion-item:last-child .details {
      border: none;
    }

    .product-tabs-wrapper[data-display-style="tabs"] .details-content {
      padding-block: var(--padding-xs, 12px);
      opacity: 1;
      block-size: auto;
    }
  }

  /* Accordion borders: Mobile view for tabs mode, or all screens for accordion mode */
  @media screen and (max-width: 749px) {
    .product-tabs-wrapper[data-display-style="tabs"] .product-tabs__panels-container {
      border-block-start: var(--style-border-width) solid var(--color-border);
      border-block-end: var(--style-border-width) solid var(--color-border);
    }
    .product-tabs-wrapper[data-display-style="tabs"] .product-tabs__accordion-item:not(:first-child) .details {
      border-block-start: var(--style-border-width) solid var(--color-border);
    }
  }

  .product-tabs-wrapper[data-display-style="accordion"] .product-tabs__panels-container {
    border-block-start: var(--style-border-width) solid var(--color-border);
    border-block-end: var(--style-border-width) solid var(--color-border);
  }
  .product-tabs-wrapper[data-display-style="accordion"] .product-tabs__accordion-item:not(:first-child) .details {
    border-block-start: var(--style-border-width) solid var(--color-border);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bliss Product Tabs",
  "tag": null,
  "class": "product-tabs-block",
  "blocks": [
    {
      "type": "_bliss-tab"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "display_style",
      "label": "Display Style",
      "options": [
        {
          "value": "tabs",
          "label": "Tabs"
        },
        {
          "value": "accordion",
          "label": "Accordion"
        }
      ],
      "default": "tabs"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Accordion Icon",
      "options": [
        {
          "value": "caret",
          "label": "Caret"
        },
        {
          "value": "plus",
          "label": "Plus"
        }
      ],
      "default": "caret"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "placeholder": "Default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "placeholder": "Default"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border/Underline Color",
      "placeholder": "Default"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Bliss Product Tabs",
      "blocks": [
        {
          "type": "_bliss-tab",
          "settings": {
            "heading": "Description",
            "content_source": "description"
          }
        }
      ]
    }
  ]
}
{% endschema %}
