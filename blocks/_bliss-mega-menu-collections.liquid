{%- doc -%}
  Promoted collections for one top-level item of the Bliss menu.
  The output is wrapped in position markers so the parent `_bliss-menu` block
  can place it inside the submenu of the matching menu item.
{%- enddoc -%}

{% liquid
  assign position = block.settings.menu_item_position | default: '1'
  assign background_color = block.settings.background_color
  assign card_style = 'default'
  if block.settings.text_placement == 'on_image'
    assign card_style = 'overlay'
  endif

  # "Next to the menu links": the collections take this share of the width, the links the rest
  assign beside = false
  if block.settings.layout == 'beside'
    assign beside = true
  endif
  assign beside_width = block.settings.beside_width | default: 40

  # Keep Horizon's link column width (6 columns across the full menu), e.g. 40% -> 4 link columns
  assign link_columns = 100 | minus: beside_width | times: 6 | divided_by: 100.0 | round
  if link_columns < 1
    assign link_columns = 1
  endif
%}

<!--bliss-mega-{{ position }}-->
{% if beside %}
  {% style %}
    @media screen and (min-width: 990px) {
      /* Links on the left. Skipped when a Mega menu images block already sits next to the links. */
      .mega-menu:has(> [data-bliss-mega-id='{{ block.id }}']):not(:has(> .bliss-mega-images))
        :is(.mega-menu__grid, .mega-menu__list) {
        --menu-columns-desktop: {{ link_columns }};
      }

      .mega-menu:has(> [data-bliss-mega-id='{{ block.id }}']):not(:has(> .bliss-mega-images)) > .mega-menu__grid {
        grid-row: 1;
        justify-self: start;
        width: calc(100% - {{ beside_width }}% - var(--gap-xl));
      }

      .mega-menu:not(:has(> .bliss-mega-images)) > [data-bliss-mega-id='{{ block.id }}'] {
        grid-row: 1;
        justify-self: end;
        width: {{ beside_width }}%;
      }
    }
  {% endstyle %}
{% endif %}
{% if background_color != blank and background_color.alpha != 0.0 %}
  {% style %}
    #header-component:has(.menu-list__list-item:is(:hover, :has([aria-expanded='true'])) [data-bliss-mega-id='{{ block.id }}']) .header__underlay {
      --color-submenu: {{ background_color }};
    }
  {% endstyle %}
{% endif %}
<div
  class="bliss-mega-collections bliss-mega-collections--text-{{ block.settings.text_placement }}"
  style="--bliss-text-align: {{ block.settings.text_alignment }}; --bliss-text-gap: {{ block.settings.text_vertical_gap }}px; --bliss-columns: {{ block.settings.columns | default: 4 }};"
  data-bliss-mega-id="{{ block.id }}"
  data-bliss-mega-position="{{ position }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <p class="bliss-mega-collections__heading h6">{{ block.settings.heading }}</p>
  {% endif %}
  {% liquid
    # Each card is roughly 1 / columns of the page width on desktop
    assign columns = block.settings.columns | default: 4
    assign area_width = 100
    if beside
      assign area_width = beside_width
    endif
    assign desktop_vw = area_width | divided_by: columns
    assign image_sizes = '(min-width: 990px) ' | append: desktop_vw | append: 'vw, 50vw'
  %}
  <ul class="bliss-mega-collections__list list-unstyled" role="list">
    {% for collection in block.settings.collections %}
      <li class="bliss-mega-collections__item">
        {% # One "Collection card" child block per collection, with closest.collection so its settings can use collection dynamic sources %}
        {% assign svg_id_prefix = 'clip-' | append: block.id | append: '-' | append: forloop.index | append: '-' %}
        {% content_for 'block',
          type: '_bliss-mega-collection-card',
          id: 'collection-card',
          closest.collection: collection,
          card_style: card_style,
          image_ratio: block.settings.image_ratio,
          image_sizes: image_sizes,
          svg_id_prefix: svg_id_prefix
        %}
      </li>
    {% else %}
      {% if request.design_mode %}
        <li class="bliss-mega-collections__item">
          {% capture card %}
            {% render 'resource-card',
              resource: collections.all,
              resource_type: 'collection',
              style: card_style,
              image_aspect_ratio: block.settings.image_ratio
            %}
          {% endcapture %}
          {% assign svg_id_prefix = 'clip-' | append: block.id | append: '-0-' %}
          {{ card | replace: 'clip0_', svg_id_prefix }}
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</div>
<!--/bliss-mega-{{ position }}-->

{% stylesheet %}
  .bliss-mega-collections {
    flex: 1 1 100%;
    padding-block-start: var(--padding-md);
  }

  .bliss-mega-collections__heading {
    margin-block: 0 var(--margin-sm);
  }

  .bliss-mega-collections__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-md);
  }

  /* Force the chosen image ratio on the media box so every card (including placeholders) matches */
  .bliss-mega-collections .resource-card__media {
    aspect-ratio: var(--resource-card-aspect-ratio, auto);
    overflow: hidden;
    border-radius: var(--resource-card-corner-radius);
  }

  .bliss-mega-collections .resource-card__media > .resource-card__image,
  .bliss-mega-collections .resource-card__image-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bliss-mega-collections .resource-card__image-placeholder {
    display: flex;
  }

  .bliss-mega-collections .resource-card__content {
    text-align: var(--bliss-text-align);
  }

  /* The menu sets white-space: nowrap (inherited here) and Horizon clamps card titles;
     always show the full collection name, wrapping onto more lines when needed */
  .bliss-mega-collections {
    white-space: normal;
  }

  .bliss-mega-collections .resource-card__title {
    width: 100%;
    display: block;
    -webkit-line-clamp: unset;
    overflow: visible;
    white-space: normal;
    overflow-wrap: break-word;
  }

  .bliss-mega-collections--text-below_image .resource-card {
    row-gap: var(--bliss-text-gap);
  }

  .bliss-mega-collections--text-on_image .resource-card__content {
    padding-block-end: var(--bliss-text-gap);
  }

  @media screen and (min-width: 990px) {
    .bliss-mega-collections__list {
      grid-template-columns: repeat(var(--bliss-columns, 4), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mega menu collections",
  "tag": null,
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "You can set a different background color for this mega menu"
    },
    {
      "type": "select",
      "id": "menu_item_position",
      "label": "Link position in main menu",
      "options": [
        { "value": "1", "label": "Item 1" },
        { "value": "2", "label": "Item 2" },
        { "value": "3", "label": "Item 3" },
        { "value": "4", "label": "Item 4" },
        { "value": "5", "label": "Item 5" },
        { "value": "6", "label": "Item 6" },
        { "value": "7", "label": "Item 7" },
        { "value": "8", "label": "Item 8" },
        { "value": "9", "label": "Item 9" },
        { "value": "10", "label": "Item 10" }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Promoted collections"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Position on desktop",
      "options": [
        { "value": "below", "label": "Below the menu links" },
        { "value": "beside", "label": "Next to the menu links" }
      ],
      "default": "below",
      "info": "Next to the menu links works like the Mega menu images block. If both blocks use the same menu item, the images stay next to the links and the collections go below."
    },
    {
      "type": "range",
      "id": "beside_width",
      "label": "Width next to the links",
      "info": "Share of the menu width for the collections. The menu links use the rest.",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 40,
      "visible_if": "{{ block.settings.layout == 'beside' }}"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "info": "Collections per row. Choose the same number as your collections to show them in one row.",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Promoted collections"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "adapt", "label": "Auto" },
        { "value": "16 / 9", "label": "Landscape" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "select",
      "id": "text_placement",
      "label": "Placement",
      "options": [
        { "value": "on_image", "label": "On image" },
        { "value": "below_image", "label": "Below image" }
      ],
      "default": "below_image"
    },
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "Alignment",
      "default": "left"
    },
    {
      "type": "range",
      "id": "text_vertical_gap",
      "label": "Vertical gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Mega menu collections"
    }
  ]
}
{% endschema %}
