{% liquid
  assign slide_count = block.blocks.size
  assign icons_style = section.settings.icons_style

  assign slideshow_class = 'carousel-content spacing-style '
  if block.settings.background_color != blank
    render 'contrast-override', background_color: block.settings.background_color, section_id: block.id
    assign slideshow_class = slideshow_class | append: ' color-custom-' | append: block.id
  endif

  assign slideshow_gutters = 'start end'

  # Desktop peek settings
  if section.settings.enable_peek != false
    assign peek_desktop = true
  else
    assign peek_desktop = false
  endif

  if section.settings.section_width == 'page-width' and peek_desktop
    assign gutter_desktop = 'var(--util-page-margin-offset)'
  else
    assign gutter_desktop = '0px'
  endif

  if peek_desktop
    assign container_width_desktop = 'min(var(--page-content-width, 1400px), 100vw - (2 * var(--page-margin, 40px)))'
    if section.settings.section_width == 'page-width'
      assign peek_size_desktop = '0px'
    else
      assign peek_size_desktop = '3rem'
    endif
  else
    assign container_width_desktop = '100%'
    assign peek_size_desktop = '0px'
  endif

  # Mobile peek settings
  if section.settings.enable_peek_mobile != false
    assign peek_mobile = true
  else
    assign peek_mobile = false
  endif

  if section.settings.section_width == 'page-width' and peek_mobile
    assign gutter_mobile = 'var(--util-page-margin-offset)'
  else
    assign gutter_mobile = '0px'
  endif

  if peek_mobile
    assign container_width_mobile = 'min(var(--page-content-width, 1400px), 100vw - (2 * var(--page-margin, 40px)))'
    if section.settings.section_width == 'page-width'
      assign peek_size_mobile = '0px'
    else
      assign peek_size_mobile = '3rem'
    endif
  else
    assign container_width_mobile = '100%'
    assign peek_size_mobile = '0px'
  endif

  assign show_arrows = false
  if icons_style != 'none'
    assign show_arrows = true
  endif

  assign slide_position = block.settings.position
  if block.settings.height == 'fill'
    assign slide_position = 'stretch'
  endif
-%}

{% capture blocks_content %}
  {% content_for 'blocks' %}
{% endcapture %}

{% capture slideshow_style %}
  --carousel-columns: {{ section.settings.columns }};
  --carousel-mobile-columns: {{ section.settings.mobile_columns }};
  --gutter-slide-width-desktop: {{ gutter_desktop }};
  --gutter-slide-width-mobile: {{ gutter_mobile }};
  --slideshow-container-width-desktop: {{ container_width_desktop }};
  --slideshow-container-width-mobile: {{ container_width_mobile }};
  --peek-next-slide-size-desktop: {{ peek_size_desktop }};
  --peek-next-slide-size-mobile: {{ peek_size_mobile }};
  {% render 'gap-style', value: section.settings.columns_gap, name: 'carousel-gap' %}
  {% render 'spacing-style', settings: block.settings %}
  {% render 'border-override', settings: block.settings %}
{% endcapture %}

{% liquid
  assign slideshow_controls = null
  if section.settings.show_dots == true
    capture slideshow_controls
      render 'slideshow-controls', style: 'dots', item_count: slide_count
    endcapture
  endif
-%}

<div
  class="
    {% if section.settings.enable_peek != false %}force-full-width-desktop{% endif %}
    {% if section.settings.enable_peek_mobile != false %}force-full-width-mobile{% endif %}
  "
>
  {% render 'slideshow',
    class: slideshow_class,
    style: slideshow_style,
    slides: blocks_content,
    show_arrows: show_arrows,
    icon_style: icons_style,
    icon_shape: section.settings.icons_shape,
    auto_hide_controls: false,
    infinite: false,
    initial_slide: 0,
    slide_count: slide_count,
    slide_position: slide_position,
    slideshow_gutters: slideshow_gutters,
    attributes: block.shopify_attributes,
    controls: slideshow_controls
  %}
</div>

{% stylesheet %}
  .carousel-content {
    --slideshow-container-width: var(--slideshow-container-width-mobile);
    --peek-next-slide-size: var(--peek-next-slide-size-mobile);
    --gutter-slide-width: var(--gutter-slide-width-mobile);
    --column-count: var(--carousel-mobile-columns);
  }

  @media screen and (min-width: 750px) {
    .carousel-content {
      --slideshow-container-width: var(--slideshow-container-width-desktop);
      --peek-next-slide-size: var(--peek-next-slide-size-desktop);
      --gutter-slide-width: var(--gutter-slide-width-desktop);
      --column-count: var(--carousel-columns);
    }
  }

  .carousel-content slideshow-slides {
    --slideshow-gap: var(--carousel-gap);
  }

  .carousel-content slideshow-slides > .card {
    flex: 0 0 auto;
    width: calc(
      (var(--slideshow-container-width, 100%) - (var(--carousel-gap, 8px) * (var(--carousel-mobile-columns, 2) - 1)) - var(--peek-next-slide-size, 0px)) /
        var(--carousel-mobile-columns, 2)
    );
  }

  @media screen and (min-width: 750px) {
    .carousel-content slideshow-slides > .card {
      width: calc(
        (var(--slideshow-container-width, 100%) - (var(--carousel-gap, 8px) * (var(--carousel-columns, 4) - 1)) - var(--peek-next-slide-size, 0px)) /
          var(--carousel-columns, 4)
      );
    }
  }

  .carousel-content .slideshow-control[disabled] {
    display: none;
  }

  .carousel-content slideshow-arrows {
    padding-inline: var(--util-page-margin-offset);
  }

  .carousel-content .slideshow-control--next {
    margin-inline-start: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.carousel_content",
  "blocks": [
    {
      "type": "_card"
    }
  ],
  "tag": null,
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:settings.card_height",
      "options": [
        {
          "value": "fit",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        }
      ],
      "default": "fit"
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:settings.position",
      "options": [
        {
          "value": "top",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "bottom",
          "label": "t:options.bottom"
        }
      ],
      "visible_if": "{{ block.settings.height == \"fit\" }}",
      "default": "top"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.carousel_content",
      "category": "t:categories.layout"
    }
  ]
}
{% endschema %}
