{%- doc -%}
  Renders a carousel of predictive search results cards

  @param {string} ref - The ref of the slideshow
  @param {object} slides - An array of HTML for the slides to display in the carousel
  @param {number} slide_count - The number of slides to display in the carousel
  @param {object} settings - The block or sections settings from the parent block/section.
  @param {string} [slide_width_max] - The maximum width of the slides in the carousel.

  @example
  {% render 'resource-list-carousel', slides: slides, slide_count: slide_count, settings: block.settings %}
{%- enddoc -%}

{% liquid
  assign slideshow_ref = ref | default: 'resourceListCarousel'
  assign slideshow_gutters = 'start end'

  # Desktop peek settings
  assign enable_peek_setting = settings.enable_peek

  if enable_peek_setting != false
    assign peek_desktop = true
  else
    assign peek_desktop = false
  endif

  if settings.section_width == 'page-width' and peek_desktop
    assign gutter_desktop = 'var(--util-page-margin-offset)'
  else
    assign gutter_desktop = '0px'
  endif

  if peek_desktop
    assign container_width_desktop = 'min(var(--page-content-width, 1400px), 100vw - (2 * var(--page-margin, 40px)))'
    if settings.section_width == 'page-width'
      assign peek_size_desktop = '0px'
    else
      assign peek_size_desktop = '3rem'
    endif
  else
    assign container_width_desktop = '100%'
    assign peek_size_desktop = '0px'
  endif

  # Mobile peek settings
  assign enable_peek_mobile_setting = settings.enable_peek_mobile

  if enable_peek_mobile_setting != false
    assign peek_mobile = true
  else
    assign peek_mobile = false
  endif

  if settings.section_width == 'page-width' and peek_mobile
    assign gutter_mobile = 'var(--util-page-margin-offset)'
  else
    assign gutter_mobile = '0px'
  endif

  if peek_mobile
    assign container_width_mobile = 'min(var(--page-content-width, 1400px), 100vw - (2 * var(--page-margin, 40px)))'
    if settings.section_width == 'page-width'
      assign peek_size_mobile = '0px'
    else
      assign peek_size_mobile = '3rem'
    endif
  else
    assign container_width_mobile = '100%'
    assign peek_size_mobile = '0px'
  endif

  assign show_arrows = false
  if settings.icons_style != 'none'
    assign show_arrows = true
  endif

  assign show_dots_setting = settings.show_dots

  assign slideshow_controls = null
  if show_dots_setting == true
    capture slideshow_controls
      render 'slideshow-controls', style: 'dots', item_count: slide_count
    endcapture
  endif

  assign mobile_columns = 1
  if settings.mobile_card_size != blank
    if settings.mobile_card_size == '44cqw'
      assign mobile_columns = 2
    else
      assign mobile_columns = 1
    endif
  elsif settings.mobile_columns != blank
    assign mobile_columns = settings.mobile_columns
  endif
%}

{% capture slides %}
  {% for item in slides limit: slides.size %}
    {% render 'slideshow-slide'
      index : forloop.index0,
      children : item,
      class : 'resource-list__slide'
    %}
  {% endfor %}
{% endcapture %}

<div
  class="bliss-carousel"
  style="--slide-width-max: {{ slide_width_max | default: '300px' }}; --column-count: {{ settings.columns | default: 3 }}; --column-count-mobile: {{ mobile_columns }}; --gutter-slide-width-desktop: {{ gutter_desktop }}; --gutter-slide-width-mobile: {{ gutter_mobile }}; --slideshow-container-width-desktop: {{ container_width_desktop }}; --slideshow-container-width-mobile: {{ container_width_mobile }}; --peek-next-slide-size-desktop: {{ peek_size_desktop }}; --peek-next-slide-size-mobile: {{ peek_size_mobile }};"
>
  {% render 'slideshow',
    ref: slideshow_ref,
    class: 'resource-list__carousel',
    slides: slides,
    show_arrows: show_arrows,
    icon_style: settings.icons_style,
    icon_shape: settings.icons_shape,
    auto_hide_controls: false,
    infinite: false,
    initial_slide: 0,
    slide_count: slide_count,
    slideshow_gutters: slideshow_gutters,
    controls: slideshow_controls
  %}
</div>

{% stylesheet %}
  .resource-list__carousel {
    --slide-width: 60vw;
    width: 100%;
    position: relative;

    .slideshow-control[disabled] {
      display: none;
    }

    .slideshow-control--next {
      margin-inline-start: auto;
    }
  }

  @media screen and (max-width: 749px) {
    .resource-list__carousel {
      --slideshow-container-width: var(--slideshow-container-width-mobile);
      --peek-next-slide-size: var(--peek-next-slide-size-mobile);
      --column-count: var(--column-count-mobile);
    }
    .resource-list__carousel slideshow-slides {
      --gutter-slide-width: var(--gutter-slide-width-mobile);
    }
    .resource-list__carousel .resource-list__slide {
      --section-slide-width: calc(
        (var(--slideshow-container-width, 100%) - (var(--resource-list-column-gap) * (var(--column-count-mobile) - 1))) /
          var(--column-count-mobile)
      );
      --slide-width: calc(var(--section-slide-width) - (var(--peek-next-slide-size) / var(--column-count-mobile)));
    }
  }

  @media screen and (min-width: 750px) {
    .resource-list__carousel {
      --slideshow-container-width: var(--slideshow-container-width-desktop);
      --peek-next-slide-size: var(--peek-next-slide-size-desktop);
    }
    .resource-list__carousel slideshow-slides {
      --gutter-slide-width: var(--gutter-slide-width-desktop);
    }
    .resource-list__carousel .resource-list__slide {
      --section-slide-width: calc(
        (var(--slideshow-container-width, 100%) - (var(--resource-list-column-gap) * (var(--column-count) - 1))) /
          var(--column-count)
      );
      --slide-width: calc(var(--section-slide-width) - (var(--peek-next-slide-size) / var(--column-count)));
    }
  }

  .resource-list__carousel slideshow-slides {
    gap: var(--resource-list-column-gap);

    /* Add padding to prevent hover animations from being clipped in slideshow
     15px accommodates:
     - Scale effect (9px on each side from 1.03 scale)
     - Lift effect (4px upward movement)
     - Shadow (15px spread with -5px offset)
     Using 16px for better alignment with our spacing scale */
    margin-block: -16px;
    padding-block: 16px;
  }

  .resource-list__carousel slideshow-arrows {
    padding-inline: var(--util-page-margin-offset);
  }

  .resource-list__carousel .resource-list__slide {
    width: var(--slide-width);
    flex: 0 0 auto;
    scroll-snap-align: start;
    min-width: 0;
  }

  /*
   * Resource list carousels have peeking slides on both sides.
   * We try to kick load them beforehand (they are lazy loaded otherwise).
   */
  .resource-list__carousel
    :is(
      slideshow-slide:has(+ slideshow-slide[aria-hidden='false']),
      slideshow-slide[aria-hidden='false'] + slideshow-slide
    ) {
    content-visibility: auto;

    slideshow-component[actioned] & {
      content-visibility: visible;
    }
  }
{% endstylesheet %}
