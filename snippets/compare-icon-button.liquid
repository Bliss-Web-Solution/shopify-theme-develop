{% doc %}
  Renders a compare icon button that overlays the product card image,
  styled identically to the quick-add button.

  @param {object} product - The product object
{% enddoc %}

{% unless product == blank %}
  <button
    type="button"
    class="compare-icon-button"
    data-compare-product-id="{{ product.id }}"
    data-product-handle="{{ product.handle }}"
    data-product-title="{{ product.title | escape }}"
    data-product-image="{{ product.featured_media | image_url: width: 100 }}"
    aria-label="{% if product.title %}{{ 'compare.compare_label' | t }}: {{ product.title }}{% else %}{{ 'compare.compare_label' | t }}{% endif %}"
  >
    <span class="svg-wrapper compare-icon-button__icon" aria-hidden="true">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/>
      </svg>
    </span>
  </button>
{% endunless %}

{% stylesheet %}
  .compare-icon-button {
    --quick-add-offset: var(--padding-sm);
    --quick-add-right: calc(var(--quick-add-offset) + var(--padding-inline-end));
    --quick-add-bottom: calc(var(--quick-add-offset) + var(--padding-block-end));
    position: absolute;
    right: max(var(--quick-add-right), calc((var(--border-radius) + var(--quick-add-right)) * (1 - cos(45deg))));
    bottom: calc(
      max(var(--quick-add-bottom), calc((var(--border-radius) + var(--quick-add-bottom)) * (1 - cos(45deg)))) +
        var(--button-size-md) + 8px
    );

    z-index: var(--layer-raised);
    display: none;
    align-items: center;
    justify-content: center;
    width: var(--button-size-md);
    height: var(--button-size-md);
    padding: 0;
    border-radius: 50px;
    border: 2px solid rgb(255, 255, 255);
    background-color: var(--quick-add-background, var(--color-background));
    color: var(--quick-add-foreground, var(--color-foreground));
    cursor: pointer;
    opacity: 0;
    pointer-events: all;
    backdrop-filter: blur(20px) saturate(180%);

    @media screen and (min-width: 750px) {
      display: flex;
    }

    &:hover {
      scale: 1.03;

      &::before {
        content: '';
        position: absolute;
        inset: -10px;
        z-index: -1;
      }
    }

    &:active {
      scale: 0.99;
    }
  }

  product-card:is(:hover, :focus-within) .compare-icon-button {
    opacity: 1;
  }

  .compare-icon-button__icon {
    width: 100%;
    height: 100%;
  }

  .compare-icon-button {
    &[data-compare-active='true'] {
      opacity: 1;
      border-color: currentColor;
      background-color: var(--color-foreground);
      color: var(--color-background);
    }

    @media (prefers-reduced-motion: no-preference) {
      transition-property: scale, opacity, background-color, color, border-color;
      transition-duration: var(--animation-speed);
      transition-timing-function: var(--ease-out-cubic);
    }

    @media screen and (max-width: 749px) {
      display: none;
    }
  }
{% endstylesheet %}
