{% doc %}
  Renders breadcrumb navigation for supported templates.
{% enddoc %}

{% liquid
  assign show_breadcrumbs = settings.breadcrumbs_enabled

  case request.page_type
    when 'collection'
      assign show_breadcrumbs = show_breadcrumbs | default: false
      if settings.breadcrumbs_collection_enabled == false
        assign show_breadcrumbs = false
      endif
    when 'product'
      if settings.breadcrumbs_product_enabled == false
        assign show_breadcrumbs = false
      endif
    when 'blog'
      if settings.breadcrumbs_blog_enabled == false
        assign show_breadcrumbs = false
      endif
    when 'article'
      if settings.breadcrumbs_article_enabled == false
        assign show_breadcrumbs = false
      endif
    when 'page'
      if settings.breadcrumbs_page_enabled == false
        assign show_breadcrumbs = false
      endif
    else
      assign show_breadcrumbs = false
  endcase

  assign separator = '/'
  case settings.breadcrumbs_separator
    when 'chevron'
      assign separator = '&rsaquo;'
    when 'pipe'
      assign separator = '|'
    when 'dot'
      assign separator = '&middot;'
  endcase

  assign current_title = ''
  assign parent_title = ''
  assign parent_url = ''

  case request.page_type
    when 'collection'
      assign current_title = collection.title
    when 'product'
      assign current_title = product.title
      assign breadcrumb_collection = blank
      assign product_collection_source = settings.breadcrumbs_product_collection_source | default: 'first_collection'
      assign primary_collection_namespace = settings.breadcrumbs_primary_collection_namespace | default: 'custom'
      assign primary_collection_key = settings.breadcrumbs_primary_collection_key | default: 'primary_collection'

      if product_collection_source == 'primary_collection_metafield'
        assign primary_collection_metafield = product.metafields[primary_collection_namespace][primary_collection_key]
        if primary_collection_metafield != blank and primary_collection_metafield.value != blank
          assign breadcrumb_collection = primary_collection_metafield.value
        endif
      elsif product_collection_source == 'current_then_first' and collection != blank
        assign breadcrumb_collection = collection
      endif

      if breadcrumb_collection == blank and product.collections.first != blank
        if product_collection_source == 'first_collection' or settings.breadcrumbs_product_collection_fallback != false
          assign breadcrumb_collection = product.collections.first
        endif
      endif

      if breadcrumb_collection != blank
        assign parent_title = breadcrumb_collection.title
        assign parent_url = breadcrumb_collection.url
      endif
    when 'blog'
      assign current_title = blog.title
    when 'article'
      assign current_title = article.title
      assign parent_title = blog.title
      assign parent_url = blog.url
    when 'page'
      assign current_title = page.title
  endcase
%}

{% if show_breadcrumbs and current_title != blank %}
  <nav
    class="breadcrumbs breadcrumbs--{{ settings.breadcrumbs_alignment }}"
    aria-label="Breadcrumb"
    style="
      --breadcrumbs-padding-block: {{ settings.breadcrumbs_spacing }}px;
      --breadcrumbs-gap: {{ settings.breadcrumbs_item_spacing }}px;
    "
  >
    <ol class="breadcrumbs__list">
      <li class="breadcrumbs__item">
        <a href="{{ routes.root_url }}" class="breadcrumbs__link">Home</a>
      </li>

      {% if parent_title != blank and parent_url != blank %}
        <li class="breadcrumbs__separator" aria-hidden="true">{{ separator }}</li>
        <li class="breadcrumbs__item">
          <a href="{{ parent_url }}" class="breadcrumbs__link">{{ parent_title | escape }}</a>
        </li>
      {% endif %}

      <li class="breadcrumbs__separator" aria-hidden="true">{{ separator }}</li>
      <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
        {{ current_title | escape }}
      </li>
    </ol>
  </nav>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ 'Home' | json }},
          "item": {{ shop.url | append: routes.root_url | json }}
        }{% if parent_title != blank and parent_url != blank %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ parent_title | json }},
          "item": {{ shop.url | append: parent_url | json }}
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ current_title | json }},
          "item": {{ shop.url | append: request.path | json }}
        }{% else %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ current_title | json }},
          "item": {{ shop.url | append: request.path | json }}
        }{% endif %}
      ]
    }
  </script>
{% endif %}

{% stylesheet %}
  .section > .breadcrumbs {
    grid-column: 2;
  }

  .breadcrumbs {
    width: 100%;
    padding-block: var(--breadcrumbs-padding-block);
    font-size: var(--font-paragraph-small--size);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .breadcrumbs__list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: calc(var(--breadcrumbs-gap) / 2) var(--breadcrumbs-gap);
    padding: 0;
    list-style: none;
  }

  .breadcrumbs--center .breadcrumbs__list {
    justify-content: center;
  }

  .breadcrumbs__link {
    color: inherit;
    text-decoration: none;
  }

  .breadcrumbs__link:hover {
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .breadcrumbs__separator {
    opacity: var(--opacity-60);
  }

  .breadcrumbs__item--current {
    color: var(--color-foreground);
  }
{% endstylesheet %}
