{% liquid
  assign max_items = section.settings.max_products | default: 4 | times: 1
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{% render 'quick-add-styles' %}
{% render 'quick-add-modal-styles' %}
{% render 'product-badges-styles' %}
{% render 'resource-list-styles' %}

<div
  class="recently-viewed-products-section"
  data-recently-viewed-section-id="{{ section.id }}"
  style="display: none;"
>
  <div
    class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>
  <div
    class="
      section
      section--{{ section.settings.section_width }}
      {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
      section-resource-list
      spacing-style
      gap-style
    "
    style="
      {% render 'spacing-style', settings: section.settings %}
      {% render 'gap-style', value: section.settings.gap %}
    "
  >
    <div class="section-resource-list__header">
      {%- content_for 'block', type: '_product-list-content', id: 'static-header' -%}
    </div>

    {% capture list_items %}
      {% for i in (1..max_items) %}
        <div
          class="resource-list__item"
          data-placeholder-slide="{{ forloop.index0 }}"
        >
          {% liquid 
            assign closest_product = product
          %}
          {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: closest_product %}
        </div>

        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
    {% endcapture %}

    {% liquid
      assign list_items_array = list_items | strip | split: '<!--@list/split-->'
    %}

    <template id="recently-viewed-template-{{ section.id }}">
      {% render 'resource-list',
        list_items: list_items,
        list_items_array: list_items_array,
        settings: section.settings,
        slide_count: max_items,
        content_type: 'products',
        test_id: 'recently-viewed-grid'
      %}
    </template>

    <div
      class="section-resource-list__content"
      style="--horizontal-alignment: {{ section.settings.horizontal_alignment }};"
    >
      {%- content_for 'blocks' -%}
    </div>
  </div>
</div>

<script>
  (function () {
    const sectionId = {{ section.id | json }};
    const sectionFileName = 'bliss-recently-viewed-products';
    const storageKey = 'recently_viewed_products';

    async function initRecentlyViewed() {
      const sectionElement = document.querySelector('[data-recently-viewed-section-id="' + sectionId + '"]');
      if (!sectionElement) return;

      let handles = [];
      try {
        handles = JSON.parse(localStorage.getItem(storageKey)) || [];
      } catch (e) {
        handles = [];
      }

      handles = handles.map(function (item) {
        if (!item) return null;
        return typeof item === 'string' ? item : item.handle;
      }).filter(Boolean);

      {% if request.page_type == 'product' %}
        handles = handles.filter(function (handle) {
          return handle !== {{ product.handle | json }};
        });
      {% endif %}

      handles = [...new Set(handles)];

      const maxProducts = {{ section.settings.max_products | default: 4 }};
      const handlesToLoad = handles.slice(0, maxProducts);

      const template = document.getElementById('recently-viewed-template-' + sectionId);
      if (!template) return;

      if (handlesToLoad.length === 0) {
        if (window.Shopify && Shopify.designMode) {
          renderClone(template, [], maxProducts, sectionElement);
          sectionElement.style.display = 'block';
        } else {
          sectionElement.style.display = 'none';
        }
        return;
      }

      const rootUrl = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) ? window.Shopify.routes.root : '/';

      const fetchPromises = handlesToLoad.map(async function (handle) {
        try {
          const url = rootUrl + 'products/' + encodeURIComponent(handle) + '?section_id=' + sectionId;
          const response = await fetch(url);
          if (!response.ok) return null;
          const html = await response.text();
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');

          const template = doc.querySelector('template');
          const item = template ? template.content.querySelector('.resource-list__item') : null;
          return item || null;
        } catch (e) {
          return null;
        }
      });

      const fetchedItems = await Promise.all(fetchPromises);
      const validCards = fetchedItems.filter(Boolean);

      renderClone(template, validCards, maxProducts, sectionElement);
      sectionElement.style.display = validCards.length > 0 ? 'block' : 'none';

      window.dispatchEvent(new Event('resize'));
    }

    function renderClone(template, validCards, maxProducts, sectionElement) {
      const frag = template.content.cloneNode(true);

      validCards.forEach(function (card, idx) {
        frag.querySelectorAll('[data-placeholder-slide="' + idx + '"]').forEach(function (placeholder) {
          const newCard = card.cloneNode(true);
          newCard.setAttribute('data-placeholder-slide', idx);
          placeholder.replaceWith(newCard);
        });
      });

      for (let i = validCards.length; i < maxProducts; i++) {
        frag.querySelectorAll('[data-placeholder-slide="' + i + '"]').forEach(function (placeholder) {
          const slide = placeholder.closest('slideshow-slide');
          (slide || placeholder).remove();
        });
      }

      const slideshow = frag.querySelector('slideshow-component');
      if (slideshow) {
        const slides = Array.from(frag.querySelectorAll('slideshow-slide'));
        slides.forEach(function (slide, idx) {
          slide.setAttribute('aria-hidden', idx === 0 ? 'false' : 'true');
          slide.style.setProperty('--slideshow-timeline', '--slide-' + idx);
          slide.setAttribute('on:click', '/select/' + idx);
        });
        slideshow.style.setProperty('--slideshow-timeline', slides.map(function (_, i) { return '--slide-' + i; }).join(','));

        const dotsContainer = frag.querySelector('.slideshow-controls__dots');
        if (dotsContainer) {
          if (slides.length <= 1) {
            dotsContainer.innerHTML = '';
            dotsContainer.hidden = true;
            dotsContainer.style.display = 'none';
          } else {
            let newDotsHtml = '';
            slides.forEach(function (_, idx) {
              newDotsHtml += '<li><button class="slideshow-control button button-unstyled" style="animation-timeline: --slide-' + idx + '" aria-label="Go to slide ' + (idx + 1) + '" on:click="/select/' + idx + '" ref="dots[]" data-target-index="' + idx + '" ' + (idx === 0 ? 'aria-selected="true"' : 'aria-selected="false"') + '>' + (idx + 1) + '</button></li>';
            });
            dotsContainer.innerHTML = newDotsHtml;
            dotsContainer.hidden = false;
            dotsContainer.style.removeProperty('display');
          }
        }
      }

      // Remove any previously injected resource-list elements
      sectionElement.querySelectorAll('.section > .resource-list, .section > div > .resource-list').forEach(function (el) {
        el.remove();
      });

      const contentDiv = sectionElement.querySelector('.section-resource-list__content');
      const parent = contentDiv ? contentDiv.parentNode : sectionElement.querySelector('.section');
      const insertBefore = contentDiv || null;
      Array.from(frag.childNodes).forEach(function (node) {
        parent.insertBefore(node, insertBefore);
      });
    }

    // -----------------------------------------------------------------
    // Initialise
    // -----------------------------------------------------------------
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initRecentlyViewed);
    } else {
      initRecentlyViewed();
    }

    document.addEventListener('recentlyViewedUpdated', initRecentlyViewed);

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail.sectionId === sectionId) {
        initRecentlyViewed();
      }
    });
  })();
</script>

