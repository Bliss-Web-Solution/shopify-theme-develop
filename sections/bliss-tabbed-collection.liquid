{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<script
  src="{{ 'bliss-tabbed-collection.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{%- if section.blocks.size > 0 -%}
<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  data-testid="tabbed-collection"
  class="
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    section-resource-list
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  <div class="section-resource-list__header">
    {%- content_for 'block', type: '_product-list-content', id: 'static-header' -%}
  </div>

  <tabbed-collection-component>
    <!-- Custom Style Variables for Tabs -->
    {% style %}
      #shopify-section-{{ section.id }} {
        {% if section.settings.tab_text_color != blank %}
          --tab-text-color: {{ section.settings.tab_text_color }};
        {% endif %}
        {% if section.settings.tab_active_color != blank %}
          --tab-active-color: {{ section.settings.tab_active_color }};
        {% endif %}
        {% if section.settings.tab_active_bg_color != blank %}
          --tab-active-bg-color: {{ section.settings.tab_active_bg_color }};
        {% endif %}
      }
    {% endstyle %}

    <!-- Tabs Navigation Wrapper (populated dynamically by JS) -->
    <div class="tabbed-collection__tabs-wrapper" style="--horizontal-alignment: {{ section.settings.tab_alignment }};">
      <div
        class="tabbed-collection__tabs"
        role="tablist"
        data-style="{{ section.settings.tab_style | default: 'underline' }}"
        ref="tabsContainer"
      ></div>
    </div>

    <!-- Tab Panels Wrapper -->
    <div class="tabbed-collection__panels" ref="panelsContainer">
      {%- content_for 'blocks' -%}
    </div>

    {%- if section.blocks.size == 0 -%}
      <div class="tabbed-collection__empty">
        <p style="text-align: center; padding: 2rem;">Please add Tab blocks inside the section settings to display collections.</p>
      </div>
    {%- endif -%}
  </tabbed-collection-component>
</div>
{%- endif -%}

{% stylesheet %}
  tabbed-collection-component {
    display: block;
    width: 100%;
  }

  .tabbed-collection__tabs-wrapper {
    display: flex;
    justify-content: var(--horizontal-alignment, center);
    border-bottom: 1px solid var(--color-border, #e5e5e5);
    margin-bottom: 2rem;
  }

  .tabbed-collection__tabs {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scrollbar-width: none; /* Hide scrollbar for clean look */
    -webkit-overflow-scrolling: touch;
    width: 100%;
    justify-content: var(--horizontal-alignment, center);
  }

  .tabbed-collection__tabs::-webkit-scrollbar {
    display: none;
  }

  .tabbed-collection__tab-btn {
    background: none;
    border: none;
    padding: 0.75rem 0.25rem;
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--tab-text-color, var(--color-text-secondary, #666));
    cursor: pointer;
    position: relative;
    white-space: nowrap;
    transition: color 0.2s ease-in-out;
  }

  .tabbed-collection__tab-btn::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--tab-active-color, var(--color-text, #000));
    transform: scaleX(0);
    transition: transform 0.2s ease-in-out;
  }

  .tabbed-collection__tab-btn.active {
    color: var(--tab-active-color, var(--color-text, #000));
    font-weight: 600;
  }

  .tabbed-collection__tab-btn.active::after {
    transform: scaleX(1);
  }

  .tabbed-collection__tab-btn:hover {
    color: var(--tab-active-color, var(--color-text, #000));
  }

  /* Pill Style */
  .tabbed-collection__tabs[data-style="pill"] {
    background: var(--color-background-secondary, #f5f5f5);
    padding: 0.25rem;
    border-radius: 2rem;
    border: none;
    gap: 0.5rem;
    width: auto;
    display: inline-flex;
    margin-bottom: -1px;
  }

  .tabbed-collection__tabs[data-style="pill"] .tabbed-collection__tab-btn {
    padding: 0.5rem 1.5rem;
    border-radius: 1.5rem;
  }

  .tabbed-collection__tabs[data-style="pill"] .tabbed-collection__tab-btn::after {
    display: none;
  }

  .tabbed-collection__tabs[data-style="pill"] .tabbed-collection__tab-btn.active {
    background-color: var(--tab-active-bg-color, var(--color-text, #000));
    color: var(--color-background, #fff);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tabbed Collection",
  "class": "ui-test-tabbed-collection",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Tab Settings"
    },
    {
      "type": "select",
      "id": "tab_style",
      "label": "Tab style",
      "options": [
        {
          "value": "underline",
          "label": "Underline"
        },
        {
          "value": "pill",
          "label": "Pill"
        }
      ],
      "default": "underline"
    },
    {
      "type": "select",
      "id": "tab_alignment",
      "label": "Tab alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "tab_text_color",
      "label": "Tab text color (Inactive)",
      "placeholder": "Default"
    },
    {
      "type": "color",
      "id": "tab_active_color",
      "label": "Tab active text color",
      "placeholder": "Default"
    },
    {
      "type": "color",
      "id": "tab_active_bg_color",
      "label": "Tab active background color (Pill style)",
      "placeholder": "Default",
      "visible_if": "{{ section.settings.tab_style == 'pill' }}"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "t:settings.carousel_on_mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.product_count",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "t:options.one_number"
        },
        {
          "value": "2",
          "label": "t:options.two_number"
        }
      ],
      "default": "2",
      "visible_if": "{{ section.settings.carousel_on_mobile == false }}"
    },
    {
      "type": "select",
      "id": "mobile_card_size",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "60cqw",
          "label": "t:options.one_number"
        },
        {
          "value": "44cqw",
          "label": "t:options.two_number"
        }
      ],
      "default": "60cqw"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "t:content.carousel_navigation"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.arrows_large"
        },
        {
          "value": "chevron_large",
          "label": "t:options.chevron_large"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "arrow"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "t:settings.icon_background",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "circle",
          "label": "t:options.circle"
        },
        {
          "value": "square",
          "label": "t:options.square"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.icons_style != 'none' }}"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Tabbed Collection",
      "settings": {
        "max_products": 8,
        "carousel_on_mobile": false,
        "columns": 4,
        "mobile_columns": "2",
        "columns_gap": 8,
        "rows_gap": 24,
        "icons_style": "arrow",
        "icons_shape": "none",
        "section_width": "page-width",
        "gap": 28,
        "padding-block-start": 48,
        "padding-block-end": 48,
        "tab_style": "underline",
        "tab_alignment": "center"
      },
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "name": "t:names.header",
          "static": true,
          "settings": {
            "content_direction": "row",
            "vertical_on_mobile": false,
            "horizontal_alignment": "space-between",
            "vertical_alignment": "flex-end",
            "align_baseline": true,
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "center",
            "gap": 12,
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "custom_height": 100,
            "background_media": "none",
            "video_position": "cover",
            "background_image_position": "cover",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "product_list_text": {
              "type": "_product-list-text",
              "name": "t:names.collection_title",
              "settings": {
                "text": "<h2>Featured Collections</h2>",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            }
          },
          "block_order": ["product_list_text"]
        }
      },
      "block_order": []
    }
  ]
}
{% endschema %}
