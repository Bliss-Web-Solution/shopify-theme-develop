<div
  class="image-gallery-section section section--{{ section.settings.section_width }} spacing-style{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}"
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}
    {% if section.settings.heading_color != blank %}--heading-color: {{ section.settings.heading_color }};{% endif %}
  "
>
  <div class="image-gallery-inner">
    {% if section.settings.heading != blank %}
      <div
        class="gallery-heading {{ section.settings.heading_preset }}"
        style="text-align: {{ section.settings.alignment }}; {% if section.settings.heading_color != blank %}color: var(--heading-color);{% endif %}"
      >
        {{ section.settings.heading }}
      </div>
    {% endif %}

    {%- liquid
      assign ratio = '1'
      case section.settings.image_ratio
        when 'landscape'
          assign ratio = '16 / 9'
        when 'portrait'
          assign ratio = '4 / 5'
        when 'square'
          assign ratio = '1'
        when 'adapt'
          assign ratio = 'auto'
      endcase
    -%}
    <div
      class="gallery-grid"
      style="--grid-columns: {{ section.settings.columns_desktop }}; --grid-columns-mobile: {{ section.settings.columns_mobile }}; --gap: {{ section.settings.gap }}px;"
    >
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'image' -%}
            <div
              class="gallery-item border-style"
              style="{% render 'border-override', settings: section.settings %}padding: {{ section.settings.image_padding }}px; --gallery-aspect-ratio: {{ ratio }};"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.media_type == 'video' -%}
                {%- if block.settings.video != blank -%}
                  <div
                    class="gallery-media-trigger"
                    data-index="{{ forloop.index0 }}"
                    data-media-type="video"
                    data-video-sources="{% for source in block.settings.video.sources %}{{ source.url }}||{{ source.mime_type }}{% unless forloop.last %},,{% endunless %}{% endfor %}"
                  >
                    {{
                      block.settings.video
                      | video_tag:
                        poster: null,
                        autoplay: false,
                        loop: true,
                        controls: false,
                        muted: true,
                        class: 'gallery-video'
                    }}
                    <span class="gallery-play-icon">
                      {{- 'icon-play.svg' | inline_asset_content -}}
                    </span>
                  </div>
                {%- else -%}
                  {% render 'placeholder-image', placeholder_name: 'image', class_name: 'placeholder-svg' %}
                {%- endif -%}
              {%- else -%}
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 800 }}"
                    alt="{{ block.settings.image.alt | escape }}"
                    loading="lazy"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    class="gallery-media-trigger"
                    data-index="{{ forloop.index0 }}"
                    data-media-type="image"
                    data-full-image="{{ block.settings.image | image_url: width: 2000 }}"
                  >
                {%- else -%}
                  {% render 'placeholder-image', placeholder_name: 'image', class_name: 'placeholder-svg' %}
                {%- endif -%}
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<!-- Lightbox structure -->
<div class="gallery-lightbox" id="GalleryLightbox-{{ section.id }}">
  <div class="gallery-lightbox__wrapper">
    <button class="gallery-prev" aria-label="Previous">
      {{- 'icon-chevron-left.svg' | inline_asset_content -}}
    </button>

    <div class="gallery-lightbox__media-container">
      <img id="GalleryLightboxImage-{{ section.id }}" alt="" width="" height="" style="display:none;">
      <video id="GalleryLightboxVideo-{{ section.id }}" controls playsinline style="display:none;"></video>
    </div>

    <button class="gallery-next" aria-label="Next">
      {{- 'icon-chevron-right.svg' | inline_asset_content -}}
    </button>
    <button class="gallery-close" aria-label="Close Gallery">
      {{- 'icon-close.svg' | inline_asset_content -}}
    </button>
  </div>
</div>

{% style %}
  .image-gallery-section .image-gallery-inner {
    width: 100%;
  }

  .image-gallery-section .gallery-grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns-mobile, 2), 1fr);
    gap: calc(var(--gap, 30px) / 2);
    margin-top: 2rem;

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(var(--grid-columns, 3), 1fr);
      gap: var(--gap, 30px);
    }
  }

  .image-gallery-section .gallery-heading {
    margin-bottom: 2rem;
  }

  .image-gallery-section .gallery-item {
    overflow: hidden;
    aspect-ratio: var(--gallery-aspect-ratio, 1);
  }

  .image-gallery-section .gallery-media-trigger {
    width: 100%;
    height: 100%;
    position: relative;
    cursor: zoom-in;
  }

  .gallery-play-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    background: rgba(0, 0, 0, 0.5);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    pointer-events: none;
    z-index: 2;
  }

  .gallery-play-icon svg {
    width: 24px;
    height: 24px;
    margin-left: 4px;
  }

  .image-gallery-section .gallery-item img,
  .image-gallery-section .gallery-item video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
    border-radius: var(--border-radius, 0);
  }

  .image-gallery-section .gallery-item svg.placeholder-svg {
    width: 100%;
    height: 100%;
    background-color: #f3f3f3;
  }

  /* Lightbox Styles */
  .gallery-lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgba(0, 0, 0, 0.85);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .gallery-lightbox.active {
    opacity: 1;
    visibility: visible;
    cursor: zoom-out;
  }

  .gallery-lightbox__wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 20px;
  }

  .gallery-lightbox__media-container {
    max-width: 80%;
    max-height: 90vh;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .gallery-lightbox__media-container img,
  .gallery-lightbox__media-container video {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .gallery-prev,
  .gallery-next,
  .gallery-close {
    background: #000000;
    border: none;
    color: white;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    transition: background 0.3s ease;
    z-index: 10;
  }

  .gallery-prev {
    left: 20px;
  }

  .gallery-next {
    right: 20px;
  }

  .gallery-close {
    top: 20px;
    right: 20px;
    transform: none;
  }

  @media screen and (max-width: 749px) {
    .gallery-lightbox__media-container {
      max-width: 100%;
    }
    .gallery-prev {
      left: 10px;
    }
    .gallery-next {
      right: 10px;
    }
  }
{% endstyle %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sectionId = '{{ section.id }}';
    const sectionEl = document.querySelector('#shopify-section-' + sectionId) || document.body;
    const lightbox = document.getElementById(`GalleryLightbox-${sectionId}`);
    if (!lightbox) return;

    const triggers = sectionEl.querySelectorAll('.gallery-media-trigger');
    if (!triggers.length) return;

    const lightboxImage = document.getElementById(`GalleryLightboxImage-${sectionId}`);
    const lightboxVideo = document.getElementById(`GalleryLightboxVideo-${sectionId}`);

    const mediaItems = Array.from(triggers).map((trigger) => {
      if (trigger.dataset.mediaType === 'video') {
        const html = (trigger.dataset.videoSources || '')
          .split(',,')
          .map((s) => (s ? `<source src="${s.split('||')[0]}" type="${s.split('||')[1] || 'video/mp4'}">` : ''))
          .join('');
        return { type: 'video', html };
      }
      return { type: 'image', src: trigger.dataset.fullImage, alt: trigger.getAttribute('alt') || '' };
    });

    let currentIndex = 0;
    const totalItems = mediaItems.length;

    const updateMedia = () => {
      const { type, html, src, alt } = mediaItems[currentIndex];
      const isVideo = type === 'video';

      lightboxImage.style.display = isVideo ? 'none' : 'block';
      lightboxVideo.style.display = isVideo ? 'block' : 'none';

      if (isVideo) {
        lightboxImage.src = '';
        lightboxVideo.innerHTML = html;
        lightboxVideo.load();
        lightboxVideo.play().catch(() => {});
      } else {
        lightboxVideo.pause();
        lightboxVideo.innerHTML = '';
        lightboxImage.src = src;
        lightboxImage.alt = alt;
      }
    };

    const toggleLightbox = (show) => {
      lightbox.classList.toggle('active', show);
      document.body.style.overflow = show ? 'hidden' : '';
      if (!show) {
        lightboxVideo.pause();
        lightboxVideo.innerHTML = '';
      }
    };

    const navigate = (dir) => {
      currentIndex = (currentIndex + dir + totalItems) % totalItems;
      updateMedia();
    };

    sectionEl.addEventListener('click', (e) => {
      const trigger = e.target.closest('.gallery-media-trigger');
      if (trigger) {
        currentIndex = parseInt(trigger.dataset.index, 10);
        updateMedia();
        toggleLightbox(true);
      }
    });

    lightbox.addEventListener('click', (e) => {
      if (
        e.target.closest('.gallery-close') ||
        e.target === lightbox ||
        e.target.classList.contains('gallery-lightbox__wrapper')
      ) {
        toggleLightbox(false);
      } else if (e.target.closest('.gallery-next')) navigate(1);
      else if (e.target.closest('.gallery-prev')) navigate(-1);
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('active')) return;
      if (e.key === 'Escape') toggleLightbox(false);
      else if (e.key === 'ArrowRight') navigate(1);
      else if (e.key === 'ArrowLeft') navigate(-1);
    });
  });
</script>

