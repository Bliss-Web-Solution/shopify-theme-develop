{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>
<div class="image-gallery-section section section--{{ section.settings.section_width }} section-{{ section.id }}-padding{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
  <div class="image-gallery-inner">
    {% if section.settings.heading != blank %}
      <div class="gallery-heading {{ section.settings.heading_preset }}" style="text-align: {{ section.settings.alignment }}; color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</div>
    {% endif %}

    {%- liquid
      assign ratio = '1'
      case section.settings.image_ratio
        when 'landscape'
          assign ratio = '16 / 9'
        when 'portrait'
          assign ratio = '4 / 5'
        when 'square'
          assign ratio = '1'
        when 'adapt'
          assign ratio = 'auto'
      endcase
    -%}
    <div class="gallery-grid" style="--grid-columns: {{ section.settings.columns_desktop }}; --grid-columns-mobile: {{ section.settings.columns_mobile }}; --gap: {{ section.settings.gap }}px;">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'image' -%}
            <div class="gallery-item border-style" style="{% render 'border-override', settings: section.settings %}padding: {{ section.settings.image_padding }}px; --gallery-aspect-ratio: {{ ratio }};" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img 
                  src="{{ block.settings.image | image_url: width: 800 }}" 
                  alt="{{ block.settings.image.alt | escape }}" 
                  loading="lazy" 
                  width="{{ block.settings.image.width }}" 
                  height="{{ block.settings.image.height }}"
                  class="gallery-image-trigger"
                  data-index="{{ forloop.index0 }}"
                  data-full-image="{{ block.settings.image | image_url: width: 2000 }}"
                >
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<!-- Lightbox structure -->
<div class="gallery-lightbox" id="GalleryLightbox-{{ section.id }}">
  <div class="gallery-lightbox__wrapper">
    <button class="gallery-prev" aria-label="Previous Image">
      {{- 'icon-chevron-left.svg' | inline_asset_content -}}
    </button>
    
    <div class="gallery-lightbox__image-container">
      <img id="GalleryLightboxImage-{{ section.id }}" src="" alt="" width="" height="">
    </div>
    
    <button class="gallery-next" aria-label="Next Image">
      {{- 'icon-chevron-right.svg' | inline_asset_content -}}
    </button>
    <button class="gallery-close" aria-label="Close Gallery">
      {{- 'icon-close.svg' | inline_asset_content -}}
    </button>
  </div>
</div>

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .image-gallery-section .image-gallery-inner {
    width: 100%;
  }

  .image-gallery-section .gallery-grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns-mobile, 2), 1fr);
    gap: calc(var(--gap, 30px) / 2);
    margin-top: 2rem;

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(var(--grid-columns, 3), 1fr);
      gap: var(--gap, 30px);
    }
  }

  .image-gallery-section .gallery-heading {
    margin-bottom: 2rem;
  }

  .image-gallery-section .gallery-item {
    cursor: zoom-in;
    overflow: hidden;
    aspect-ratio: var(--gallery-aspect-ratio, 1); 
  }

  .image-gallery-section .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
    border-radius: var(--border-radius, 0);
  }
  
  .image-gallery-section .gallery-item svg.placeholder-svg {
    width: 100%;
    height: 100%;
    background-color: #f3f3f3;
  }

  .image-gallery-section .gallery-item:hover img {
    transform: scale(1.05);
  }

  /* Lightbox Styles */
  .gallery-lightbox {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgba(0, 0, 0, 0.85);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .gallery-lightbox.active {
    opacity: 1;
    visibility: visible;
    cursor: zoom-out;
  }

  .gallery-lightbox__wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 20px;
  }

  .gallery-lightbox__image-container {
    max-width: 80%;
    max-height: 90vh;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .gallery-lightbox__image-container img {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
  }

  .gallery-prev, .gallery-next, .gallery-close {
    background: #000000;
    border: none;
    color: white;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    transition: background 0.3s ease;
    z-index: 10;
  }

  .gallery-prev {
    left: 20px;
  }
  .gallery-next {
    right: 20px;
  }
  
  .gallery-close {
    top: 20px;
    right: 20px;
    transform: none;
  }
  
  @media screen and (max-width: 749px) {
    .gallery-lightbox__image-container {
      max-width: 100%;
    }
    .gallery-prev {
      left: 10px;
    }
    .gallery-next {
      right: 10px;
    }
  }
{% endstyle %}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = '{{ section.id }}';
    // Use closest section element to scope
    const sectionEl = document.querySelector('#shopify-section-' + sectionId) || document.body;
    
    const triggers = sectionEl.querySelectorAll('.gallery-image-trigger');
    const lightbox = document.getElementById(`GalleryLightbox-${sectionId}`);
    
    if (!lightbox || triggers.length === 0) return;

    const lightboxImage = document.getElementById(`GalleryLightboxImage-${sectionId}`);
    const prevBtn = lightbox.querySelector('.gallery-prev');
    const nextBtn = lightbox.querySelector('.gallery-next');
    const closeBtn = lightbox.querySelector('.gallery-close');
    
    let currentIndex = 0;
    const images = Array.from(triggers).map(trigger => trigger.getAttribute('data-full-image'));
    const alts = Array.from(triggers).map(trigger => trigger.getAttribute('alt'));

    function openLightbox(index) {
      if (images.length === 0) return;
      currentIndex = index;
      updateLightboxImage();
      lightbox.classList.add('active');
      document.body.style.overflow = 'hidden'; // Prevent background scrolling
    }

    function closeLightbox() {
      lightbox.classList.remove('active');
      document.body.style.overflow = '';
    }

    function updateLightboxImage() {
      lightboxImage.src = images[currentIndex];
      lightboxImage.alt = alts[currentIndex];
    }

    function showNext() {
      currentIndex = (currentIndex + 1) % images.length;
      updateLightboxImage();
    }

    function showPrev() {
      currentIndex = (currentIndex - 1 + images.length) % images.length;
      updateLightboxImage();
    }

    triggers.forEach((trigger, index) => {
      trigger.addEventListener('click', () => openLightbox(index));
    });

    closeBtn.addEventListener('click', closeLightbox);
    
    if (nextBtn) {
      nextBtn.addEventListener('click', (e) => {
        e.stopPropagation(); // prevent closing if clicking button
        showNext();
      });
    }
    
    if (prevBtn) {
      prevBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        showPrev();
      });
    }

    // Close when clicking outside image
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || e.target.classList.contains('gallery-lightbox__wrapper')) {
        closeLightbox();
      }
    });

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('active')) return;
      
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') showNext();
      if (e.key === 'ArrowLeft') showPrev();
    });
  });
</script>

