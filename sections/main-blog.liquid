<script
  src="{{ 'blog-posts-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<blog-posts-list section-id="{{ section.id }}">
  <div
    class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>
  <div
    class="
      section
      {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
      blog-posts
      spacing-style
      size-style
    "
    data-testid="blog-posts"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% content_for 'blocks' %}

    {% assign articles_per_page = section.settings.articles_per_page | default: 12 %}

    {% paginate blog.articles by articles_per_page %}
      <div
        ref="grid"
        class="blog-posts-container"
        data-last-page="{{ paginate.pages }}"
      >
        {% for article in blog.articles %}
          <div
            id="{{ section.id }}-{{ article.id }}"
            class="blog-post-item"
            data-testid="blog-post-item"
            data-article-id="{{ article.id }}"
            data-page="{{ paginate.current_page }}"
            ref="cards[]"
          >
            {% content_for 'block', id: 'static-blog-post-card', type: '_blog-post-card', article: article %}
          </div>
        {% endfor %}
      </div>

      {% if section.settings.enable_infinite_scroll != false %}
        <span ref="viewMoreNext"></span>
      {% elsif section.settings.pagination_type == 'load_more' %}
        {% if paginate.next %}
          <div class="blog-posts__load-more">
            <button ref="loadMoreButton" type="button" class="button button--secondary">Load More</button>
          </div>
        {% endif %}
      {% else %}
        {% render 'pagination-controls', paginate: paginate %}
      {% endif %}
    {% endpaginate %}
  </div>
</blog-posts-list>

{% stylesheet %}
  /**
   * Blog posts page layout
   */
  .blog-posts {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
    --columns-gap: 36px;
    --rows-gap: 36px;
  }

  .blog-posts-container {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1rem;
    width: 100%;
    column-gap: var(--columns-gap);
    row-gap: var(--rows-gap);
  }

  @media screen and (min-width: 750px) {
    .blog-posts-container {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .blog-post-item {
    --blog-post-card-scale: 1;
    background-color: var(--color-background);
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    padding: 0 1rem 1rem;
  }

  .blog-post-item:has(.blog-post-card__image-container) {
    border: none;
    padding: 0;
  }

  .blog-posts__load-more {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin-top: 32px;
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_posts",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "select",
      "id": "pagination_type",
      "label": "t:settings.pagination_style",
      "options": [
        {
          "value": "numbers",
          "label": "t:options.numbered_pagination"
        },
        {
          "value": "load_more",
          "label": "t:options.load_more_button"
        }
      ],
      "default": "numbers",
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "t:settings.articles_per_page",
      "min": 1,
      "max": 36,
      "step": 1,
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
