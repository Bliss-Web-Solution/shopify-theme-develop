{% if section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}
{% if section.settings.animation == 'marquee' %}
  <script
    src="{{ 'marquee.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
>
  {% liquid
    assign autoplay = false
    assign show_arrows = false
    if section.blocks.size > 1
      assign autoplay = true
      assign show_arrows = true
    endif
  %}

  {% capture announcement_blocks %}
    {% content_for 'blocks' %}
  {% endcapture %}

  {% if section.settings.animation == 'marquee' %}
    <marquee-component
      class="announcement-bar__marquee"
      style="--marquee-direction: normal; --marquee-gap: 40px;"
      data-speed-factor="{{ section.settings.speed | times: 10 }}"
      data-movement-direction="normal"
    >
      <div class="marquee__wrapper" ref="wrapper">
        <div class="marquee__content" ref="content">
          <div class="marquee__repeated-items" ref="marqueeItems[]">
            {{ announcement_blocks }}
          </div>
        </div>
      </div>
    </marquee-component>
  {% else %}
    <announcement-bar-component
      class="announcement-bar__slider"
      data-animation="{{ section.settings.animation }}"
      {% if autoplay == true %}
        autoplay="{{ section.settings.speed }}" aria-live="polite"
      {% endif %}
    >
      {% if show_arrows %}
        {% render 'slideshow-arrows', icon_style: 'chevron' %}
      {% endif %}

      <div class="announcement-bar__slides">
        {{ announcement_blocks }}
      </div>
    </announcement-bar-component>
  {% endif %}
</aside>

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
  }

  .announcement-bar__text {
    margin-top: 0;
  }
  marquee-component.announcement-bar__marquee {
    display: block;
    width: 100%;
    overflow: hidden;
  }

  .announcement-bar__marquee .marquee__wrapper {
    display: flex;
    gap: 100px;
    width: fit-content;
    white-space: nowrap;
    align-items: center;
  }

  .announcement-bar__marquee .marquee__content {
    min-width: max-content;
    display: flex;
    gap: 100px;
    align-items: center;
  }

  .announcement-bar__marquee .marquee__content p {
    white-space: nowrap;
  }

  .announcement-bar__marquee .marquee__repeated-items {
    min-width: max-content;
    display: flex;
    gap: 100px;
    align-items: center;
    justify-content: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    marquee-component.announcement-bar__marquee:not([data-disabled]) .marquee__wrapper {
      animation: marquee-motion var(--marquee-speed) linear infinite var(--marquee-direction);
    }
  }

  @keyframes marquee-motion {
    to {
      transform: translate3d(calc(-50% - (var(--marquee-gap) / 2)), 0, 0);
    }
  }

  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  .announcement-bar__slides {
    width: calc(100% - var(--button-size) * 2);
    max-width: 680px;
    margin-inline: auto;
  }

  /* Fade Animation */
  announcement-bar-component[data-animation="fade"] .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
  }

  announcement-bar-component[data-animation="fade"] .announcement-bar__slides > * {
    grid-area: stack;
  }

  announcement-bar-component[data-animation="fade"] .announcement-bar__slide {
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
    content-visibility: visible;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
    }
  }

  .announcement-bar__content-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  /* Horizontal and Vertical Slide Animations */
  announcement-bar-component[data-animation="horizontal"],
  announcement-bar-component[data-animation="vertical"] {
    overflow: hidden;

    .announcement-bar__slides {
      display: grid;
      grid: [stack] auto / [stack] minmax(0, 1fr);
      width: 100%;
      overflow: hidden;
    }

    .announcement-bar__slide {
      grid-area: stack;
      transition: transform 0.5s ease-in-out;
      z-index: 1;
      opacity: 0;
      transform: translateX(100%);

      &:not([data-position]):first-child,
      &[data-position="active"],
      &[data-position="next"],
      &[data-position="prev"] {
        opacity: 1 !important;
        visibility: visible !important;
        content-visibility: visible !important;
      }

      &:not([data-position]):first-child,
      &[data-position="active"] {
        transform: translate(0, 0);
        z-index: 2;
      }

      &[data-position="hidden"] {
        transition: none;
        opacity: 0 !important;
      }
    }

    &.is-initializing .announcement-bar__slide {
      transition: none !important;
    }
  }

  /* Direction Specific Transforms */
  announcement-bar-component[data-animation="horizontal"] .announcement-bar__slide {
    &[data-position="next"], &[data-position="hidden"] { transform: translateX(100%); }
    &[data-position="prev"] { transform: translateX(-100%); }
  }

  announcement-bar-component[data-animation="vertical"] .announcement-bar__slide {
    &[data-position="next"], &[data-position="hidden"] { transform: translateY(100%); }
    &[data-position="prev"] { transform: translateY(-100%); }
  }

  .announcement-bar__marquee .announcement-bar__slide {
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
    transition: none !important;
    content-visibility: visible !important;
    width: max-content !important;
    flex-shrink: 0;
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--color-foreground);
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: var(--button-size);
    height: var(--button-size);
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;

    @media screen and (min-width: 750px) {
      --slideshow-control-offset: calc((var(--button-size) - var(--icon-size-xs)) / 2);

      .section--page-width &.slideshow-control--previous {
        transform: translateX(var(--slideshow-control-offset));
      }
    }
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .announcement-bar__slide {
    place-content: center;
  }

  .announcement-bar__text:first-child {
    margin: 0;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation Type",
      "options": [
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "vertical",
          "label": "Vertical"
        },
        {
          "value": "marquee",
          "label": "Marquee"
        }
      ],
      "default": "fade"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
